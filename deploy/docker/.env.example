# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored; this template is not.

# ── PostgreSQL ──
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=change_me
DB_USER=ecom_user
DB_PASSWORD=change_me

# ── MongoDB (user-service) ──
MONGO_URI=mongodb://mongo:27017/userdb

# ── Kafka ──
# Must be identical for order-service and notification-service or the
# consumer silently receives nothing.
KAFKA_BROKERS=kafka:9092

# ── Keycloak ──
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change_me

# ── Tracing ──
ZIPKIN_URL=http://zipkin:9411/api/v2/spans

# ── pgAdmin ──
PGADMIN_DEFAULT_EMAIL=admin@ecom.local
PGADMIN_DEFAULT_PASSWORD=change_me

# ── Loki object store ──
MINIO_ROOT_USER=loki
MINIO_ROOT_PASSWORD=change_me

# ── RabbitMQ ──
# The broker container is still defined in compose, but no Java code uses it:
# messaging moved to Kafka. These exist only so the placeholders resolve.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
